generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  student   Student?
  teacher   Teacher?
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

model Student {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  fatherName         String?
  motherName         String?
  mobile             String?
  address            String?
  photo              String?
  registrationNumber String?  @unique
  rollNumber         String?
  
  enrollments        Enrollment[]
  attendance         Attendance[]
  payments           Payment[]
  testResults        TestResult[]
  results            Result[]
}

model Teacher {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  photo         String?
  qualification String?
  experience    String?
  subjects      String[]
  socialLinks   Json?
  
  courses       Course[]
  batches       Batch[]
}

model Course {
  id          String   @id @default(uuid())
  name        String
  category    String   // JEE, NEET, Foundation, etc.
  description String?
  subjects    String[]
  fees        Float?
  duration    String?
  image       String?
  status      String   @default("published")
  
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  
  batches     Batch[]
  enrollments Enrollment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Batch {
  id          String   @id @default(uuid())
  name        String   // Morning, Evening, Weekend
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  time        String?
  createdAt   DateTime @default(now())
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        DateTime
  status      String   // Present, Absent
  createdAt   DateTime @default(now())
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Float
  status      String   // pending, completed
  method      String?
  invoiceUrl  String?
  createdAt   DateTime @default(now())
}

model MockTest {
  id          String   @id @default(uuid())
  title       String
  durationMin Int
  questions   Question[]
  results     TestResult[]
  createdAt   DateTime @default(now())
}

model Question {
  id          String   @id @default(uuid())
  testId      String
  test        MockTest @relation(fields: [testId], references: [id])
  content     String
  options     Json     // ["A", "B", "C", "D"]
  correct     String
  marks       Int      @default(4)
  negative    Int      @default(1)
}

model TestResult {
  id          String   @id @default(uuid())
  testId      String
  test        MockTest @relation(fields: [testId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  score       Int
  totalMarks  Int
  answers     Json     // Store student answers
  createdAt   DateTime @default(now())
}

model Result {
  id                 String   @id @default(uuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id])
  examName           String   // JEE, NEET
  air                Int?     // All India Rank
  marks              Int
  photo              String?
  successStory       String?
  createdAt          DateTime @default(now())
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  content     String
  image       String?
  categories  String[]
  tags        String[]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  content     String
  type        String   // Admission, Holiday, Exam
  pdfUrl      String?
  pinned      Boolean  @default(false)
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model GalleryPhoto {
  id          String       @id @default(uuid())
  url         String
  category    String?      // Event, Classroom
  createdAt   DateTime     @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  content     String
  rating      Int      @default(5)
  image       String?
  status      String   @default("approved")
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  message     String
  status      String   @default("unread") // unread, replied
  createdAt   DateTime @default(now())
}

model Topper {
  id        String   @id @default(uuid())
  name      String
  class     String
  score     String
  rank      String
  year      Int      @default(2026)
  createdAt DateTime @default(now())
}